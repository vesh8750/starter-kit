# Copy to .env for local development:  cp .env.example .env
# Every variable here maps 1:1 to a field on app.core.config.Settings.

ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_RENDERER=console              # console | json  (json in deployed environments)

# Must be >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789

# Async SQLAlchemy URL (driver must be asyncpg)
DATABASE_URL=postgresql+asyncpg://localhost:5432/pet_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# CORS: JSON list or comma-separated. Empty disables the middleware entirely.
CORS_ORIGINS=["http://localhost:3000"]

# Cache backend: memory | redis
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Storage backend: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600

# Outbound HTTP defaults
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
MAX_REQUEST_BODY_BYTES=12582912
